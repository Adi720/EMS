# Copy to .env and fill in. Never commit .env.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: the public origin(s), e.g. https://ems.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production: use a non-guessable path, e.g. manage-7f3k/
DJANGO_ADMIN_URL=admin/

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://ems_seva:change-me@localhost:5432/ems_seva
# Optional separate database for tests (the test runner creates test_<name>)
# TEST_DATABASE_URL=postgres://ems_seva:change-me@localhost:5432/ems_seva
# Quick local alternative without PostgreSQL (development only):
# DATABASE_URL=sqlite:///db.sqlite3

TIME_ZONE=Asia/Kolkata
SESSION_IDLE_TIMEOUT_SECONDS=7200

# Business settings
PHONE_DEFAULT_REGION=IN
ALLOCATION_CYCLE_MONTHS=3
ROTATION_REMINDER_DAYS=14
IMPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_MAX_ROWS=5000

# Email (Saturday reminders). Default prints emails to the console instead of sending.
# Gmail example (use an App Password; write @ in the username as %40):
# EMAIL_URL=smtp+tls://yourname%40gmail.com:your-app-password@smtp.gmail.com:587
# DEFAULT_FROM_EMAIL=EMS Seva <yourname@gmail.com>
# Public address of the site, used in reminder links:
SITE_URL=http://127.0.0.1:8000
# Reminder day (Monday=0 ... Saturday=5) and whether the reminder job also starts calling.
REMINDER_WEEKDAY=5
REMINDER_AUTO_START=True
